    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'llvm_analyzer'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=llvm_analyzer"
                ]
            },
            "args": [
                "--filename",
                "taint_tests/test2.ll"
            ]
        },
        {
            "name": "Debug unit tests in executable 'llvm_analyzer'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=llvm_analyzer"
                ]
            }
        }
    ]
}
